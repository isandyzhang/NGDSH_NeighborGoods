# 第一階段：編譯 (使用完整的 SDK)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /app

# 1. 複製還原圖所需之 csproj（僅 API 時 restore 會略過參考專案，publish --no-restore 會 NETSDK1004）
COPY NeighborGoods.Data/NeighborGoods.Data.csproj ./NeighborGoods.Data/
COPY NeighborGoods.Messaging/NeighborGoods.Messaging.csproj ./NeighborGoods.Messaging/
COPY NeighborGoods.Notifications/NeighborGoods.Notifications.csproj ./NeighborGoods.Notifications/
COPY NeighborGoods.Workers/NeighborGoods.Workers.csproj ./NeighborGoods.Workers/
COPY NeighborGoods.Api/NeighborGoods.Api.csproj ./NeighborGoods.Api/
RUN dotnet restore ./NeighborGoods.Api/NeighborGoods.Api.csproj

# 2. 複製剩下的程式碼
COPY . ./

# 3. 發布 API 專案
RUN dotnet publish ./NeighborGoods.Api/NeighborGoods.Api.csproj -c Release -o /out --no-restore

# 第二階段：執行 (使用輕量 Runtime)
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build-env /out .
ENTRYPOINT ["dotnet", "NeighborGoods.Api.dll"]


